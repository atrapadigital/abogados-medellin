---
import { getCalendlyUrl } from '../lib/calendly';

const calendlyUrl = getCalendlyUrl();
---

<header class="site-header">
	<div class="header-inner">
		<a href="#top" class="logo">
			<span class="logo-mark">S&amp;R</span>
			<span class="logo-text">Salazar<em>&amp; Reyes</em></span>
		</a>

		<nav class="nav-links">
			<a href="#servicios">Áreas de práctica</a>
			<a href="#nosotros">Por qué elegirnos</a>
			<a href="#testimonios">Casos de éxito</a>
			<a href="#contacto">Contacto</a>
		</nav>

		<div class="header-actions">
			<a class="phone-link" href="tel:+573004567890">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
				<span>300 456 7890</span>
			</a>
			<button type="button" class="btn-nav" data-calendly-url={calendlyUrl}>Agenda tu consulta</button>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(10, 9, 8, 0.88);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-line);
	}

	.header-inner {
		max-width: 1240px;
		margin: 0 auto;
		padding: 16px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--color-ink);
		flex-shrink: 0;
	}

	.logo-mark {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: var(--color-gold);
		color: var(--color-bg);
		display: grid;
		place-items: center;
		font-family: var(--font-display);
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.logo-text {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
	}

	.logo-text em {
		font-style: italic;
		color: var(--color-gold-light);
		margin-left: 2px;
	}

	.nav-links {
		display: flex;
		gap: 32px;
		font-size: 0.9rem;
		font-weight: 500;
	}

	.nav-links a {
		text-decoration: none;
		color: var(--color-ink);
		opacity: 0.72;
		transition: opacity 0.2s ease;
		position: relative;
	}

	.nav-links a:hover {
		opacity: 1;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-shrink: 0;
	}

	.phone-link {
		display: flex;
		align-items: center;
		gap: 6px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.86rem;
		color: var(--color-gold-light);
	}

	.btn-nav {
		background: var(--color-gold);
		color: var(--color-bg);
		text-decoration: none;
		border: none;
		font-family: var(--font-body);
		cursor: pointer;
		padding: 10px 20px;
		border-radius: 999px;
		font-weight: 600;
		font-size: 0.86rem;
		transition: transform 0.2s ease, background 0.2s ease;
		box-shadow: 0 4px 14px rgba(200, 162, 74, 0.3);
	}

	.btn-nav:hover {
		background: var(--color-gold-light);
		transform: translateY(-1px);
	}

	@media (max-width: 860px) {
		.nav-links {
			display: none;
		}
		.phone-link span {
			display: none;
		}
	}
</style>
