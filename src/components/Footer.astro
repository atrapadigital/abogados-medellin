</footer>

<style>
	.site-footer {
		position: relative;
		background: linear-gradient(160deg, var(--color-section) 0%, var(--color-bg-deep) 100%);
		color: rgba(244, 238, 224, 0.8);
		padding: 0 24px 24px;
		overflow: hidden;
	}

	.footer-wave {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		line-height: 0;
		transform: translateY(-99%);
	}

	.footer-wave svg {
		width: 100%;
		height: 60px;
		display: block;
	}

	.footer-wave path {
		fill: var(--color-section);
	}

	.footer-glow {
		position: absolute;
		top: -120px;
		right: -100px;
		width: 420px;
		height: 420px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(200, 162, 74, 0.16), transparent 70%);
		pointer-events: none;
	}

	.footer-cta {
		position: relative;
		max-width: 1160px;
		margin: 0 auto 56px;
		padding-top: 56px;
	}

	.footer-cta-inner {
		background: linear-gradient(120deg, rgba(200, 162, 74, 0.12), rgba(244, 238, 224, 0.03));
		border: 1px solid var(--color-line);
		border-radius: 24px;
		padding: 36px 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		flex-wrap: wrap;
	}

	.eyebrow {
		display: inline-block;
		font-weight: 600;
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-gold-light);
		margin-bottom: 8px;
	}

	.footer-cta-inner h3 {
		font-size: clamp(1.3rem, 2.2vw, 1.7rem);
		color: var(--color-ink);
		max-width: 26ch;
	}

	.footer-cta-actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.btn-cta-primary {
		background: var(--color-gold);
		color: var(--color-bg);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.88rem;
		padding: 13px 24px;
		border-radius: 999px;
		box-shadow: 0 8px 20px rgba(200, 162, 74, 0.3);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease;
		white-space: nowrap;
	}

	.btn-cta-primary:hover {
		transform: translateY(-2px);
		background: var(--color-gold-light);
	}

	.btn-cta-ghost {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.88rem;
		padding: 13px 22px;
		border-radius: 999px;
		border: 1.5px solid var(--color-line);
		color: var(--color-ink);
		transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
		white-space: nowrap;
	}

	.btn-cta-ghost:hover {
		border-color: rgba(200, 162, 74, 0.5);
		background: rgba(200, 162, 74, 0.08);
		transform: translateY(-2px);
	}

	.footer-inner {
		position: relative;
		max-width: 1160px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr 1fr;
		gap: 40px;
		padding-bottom: 48px;
	}

	.logo-text {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-ink);
	}

	.logo-mark {
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: rgba(200, 162, 74, 0.14);
		border: 1px solid var(--color-line);
		color: var(--color-gold-light);
		display: grid;
		place-items: center;
		font-size: 0.8rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.logo-text em {
		font-style: italic;
		color: var(--color-gold-light);
	}

	.footer-brand p {
		margin-top: 16px;
		font-size: 0.85rem;
		line-height: 1.6;
		color: rgba(244, 238, 224, 0.55);
		max-width: 30ch;
	}

	.social-row {
		display: flex;
		gap: 10px;
		margin-top: 22px;
	}

	.social-btn {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: rgba(244, 238, 224, 0.06);
		border: 1px solid var(--color-line);
		color: rgba(244, 238, 224, 0.75);
		transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease, color 0.25s ease;
	}

	.social-btn:hover {
		background: var(--color-gold);
		border-color: var(--color-gold);
		color: var(--color-bg);
		transform: translateY(-3px);
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-col strong {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-gold-light);
		margin-bottom: 4px;
	}

	.footer-col a,
	.footer-col span {
		text-decoration: none;
		font-size: 0.88rem;
		color: rgba(244, 238, 224, 0.7);
	}

	.footer-col a {
		transition: color 0.2s ease, transform 0.2s ease;
		width: fit-content;
	}

	.footer-col a:hover {
		color: var(--color-ink);
		transform: translateX(3px);
	}

	.footer-link-icon {
		display: flex;
		align-items: center;
		gap: 9px;
	}

	.footer-link-icon svg {
		flex-shrink: 0;
		opacity: 0.7;
	}

	.footer-bottom {
		position: relative;
		max-width: 1160px;
		margin: 0 auto;
		border-top: 1px solid var(--color-line);
		padding-top: 24px;
		font-size: 0.78rem;
		color: rgba(244, 238, 224, 0.45);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px;
	}

	@media (max-width: 800px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
		}

		.footer-cta-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (max-width: 520px) {
		.footer-inner {
			grid-template-columns: 1fr;
		}

		.footer-cta-inner {
			padding: 28px 24px;
		}
	}
</style>
