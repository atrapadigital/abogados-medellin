---
import { getCalendlyUrl } from '../lib/calendly';

const calendlyUrl = getCalendlyUrl();
---

<section class="hero" id="top">
	<div class="hero-bg-shape"></div>
	<div class="hero-inner">
		<div class="hero-copy">
			<span class="eyebrow hero-fade" style="animation-delay: 0.05s">Abogados litigantes en Medellín</span>
			<h1 class="hero-fade" style="animation-delay: 0.15s">
				Defendemos tus derechos con <em>estrategia</em> y experiencia
			</h1>
			<p class="hero-lead hero-fade" style="animation-delay: 0.28s">
				Asesoría legal integral en derecho civil, penal, laboral y comercial. Evaluamos tu
				caso sin costo y te damos una ruta clara de acción en menos de 24 horas.
			</p>

			<div class="hero-cta-row hero-fade" style="animation-delay: 0.4s">
				<button type="button" class="btn-primary" data-calendly-url={calendlyUrl}>
					Agenda tu consulta gratuita
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</button>
				<a href="https://wa.me/573004567890" target="_blank" rel="noopener" class="btn-ghost">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.32A8.9 8.9 0 0 0 12.05 4C7.4 4 3.62 7.78 3.62 12.42c0 1.5.4 2.96 1.13 4.24L3.5 20.5l3.94-1.23a8.87 8.87 0 0 0 4.6 1.26c4.65 0 8.43-3.78 8.43-8.43a8.83 8.83 0 0 0-2.87-6.28ZM12.05 19c-1.45 0-2.87-.39-4.1-1.13l-.29-.17-2.44.76.78-2.38-.19-.3a7.36 7.36 0 0 1-1.13-3.94c0-4.05 3.3-7.35 7.35-7.35 1.97 0 3.81.77 5.2 2.16a7.3 7.3 0 0 1 2.15 5.19c0 4.05-3.3 7.36-7.33 7.36Z"></path></svg>
					Escríbenos por WhatsApp
				</a>
			</div>

			<div class="hero-trust hero-fade" style="animation-delay: 0.52s">
				<div class="stars" aria-hidden="true">★★★★★</div>
				<p><strong>4.9/5</strong> · +600 casos resueltos en Antioquia</p>
			</div>
		</div>

		<div class="hero-visual hero-fade-scale" style="animation-delay: 0.25s">
			<div class="hero-image-frame">
				<img
					src="https://cdn.pixabay.com/photo/2017/10/05/20/49/office-2820890_1280.jpg"
					alt="Abogado revisando documentos legales en su escritorio"
					loading="eager"
				/>
			</div>
			<div class="floating-card card-top float-anim">
				<div class="floating-icon">✓</div>
				<div>
					<strong>Confidencialidad total</strong>
					<span>Reserva profesional garantizada</span>
				</div>
			</div>
			<div class="floating-card card-bottom float-anim-alt">
				<div class="floating-icon alt">%</div>
				<div>
					<strong>Honorarios flexibles</strong>
					<span>Cuota litis según tu caso</span>
				</div>
			</div>
		</div>
	</div>

	<div class="hero-marquee" aria-hidden="true">
		<div class="marquee-track">
			<span>Derecho Civil</span><span>·</span>
			<span>Derecho Penal</span><span>·</span>
			<span>Derecho Laboral</span><span>·</span>
			<span>Derecho Comercial</span><span>·</span>
			<span>Derecho de Familia</span><span>·</span>
			<span>Derecho Civil</span><span>·</span>
			<span>Derecho Penal</span><span>·</span>
			<span>Derecho Laboral</span><span>·</span>
			<span>Derecho Comercial</span><span>·</span>
			<span>Derecho de Familia</span><span>·</span>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: 64px 24px 0;
		overflow: hidden;
	}

	.hero-fade {
		opacity: 0;
		animation: heroFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.hero-fade-scale {
		opacity: 0;
		animation: heroFadeScale 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@keyframes heroFadeUp {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes heroFadeScale {
		from {
			opacity: 0;
			transform: scale(0.94) translateY(16px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.float-anim {
		animation: floatUpDown 5s ease-in-out infinite;
		animation-delay: 1s;
	}

	.float-anim-alt {
		animation: floatUpDown 5.5s ease-in-out infinite;
		animation-delay: 1.3s;
	}

	@keyframes floatUpDown {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	.hero-bg-shape {
		position: absolute;
		top: -220px;
		right: -180px;
		width: 620px;
		height: 620px;
		border-radius: 50%;
		background: radial-gradient(circle at 30% 30%, rgba(200, 162, 74, 0.16), transparent 70%);
		z-index: 0;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: 1240px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: 48px;
		align-items: center;
		padding-bottom: 56px;
	}

	.eyebrow {
		display: inline-block;
		font-weight: 600;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-gold-light);
		background: rgba(200, 162, 74, 0.1);
		padding: 7px 14px;
		border-radius: 999px;
		margin-bottom: 22px;
	}

	h1 {
		font-size: clamp(2.4rem, 4.4vw, 3.6rem);
		line-height: 1.06;
		color: var(--color-ink);
	}

	h1 em {
		font-style: italic;
		color: var(--color-gold-light);
	}

	.hero-lead {
		margin-top: 22px;
		font-size: 1.1rem;
		line-height: 1.6;
		color: rgba(244, 238, 224, 0.72);
		max-width: 46ch;
	}

	.hero-cta-row {
		display: flex;
		gap: 14px;
		margin-top: 34px;
		flex-wrap: wrap;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: var(--color-gold);
		color: var(--color-bg);
		text-decoration: none;
		border: none;
		font-family: var(--font-body);
		font-size: 1rem;
		cursor: pointer;
		font-weight: 600;
		padding: 16px 26px;
		border-radius: 999px;
		box-shadow: 0 10px 24px rgba(200, 162, 74, 0.28);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.btn-primary:hover {
		background: var(--color-gold-light);
		transform: translateY(-2px);
		box-shadow: 0 14px 30px rgba(200, 162, 74, 0.36);
	}

	.btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		font-weight: 600;
		padding: 16px 22px;
		border-radius: 999px;
		border: 1.5px solid var(--color-line);
		color: var(--color-ink);
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.btn-ghost:hover {
		border-color: var(--color-gold);
		background: rgba(200, 162, 74, 0.06);
	}

	.hero-trust {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 32px;
	}

	.stars {
		color: var(--color-gold-light);
		letter-spacing: 2px;
	}

	.hero-trust p {
		font-size: 0.9rem;
		color: rgba(244, 238, 224, 0.65);
	}

	.hero-visual {
		position: relative;
	}

	.hero-image-frame {
		border-radius: 28px;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.65);
		border: 6px solid var(--color-surface);
		outline: 1px solid var(--color-line);
	}

	.hero-image-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.floating-card {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 12px;
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		padding: 12px 16px;
		border-radius: 16px;
		box-shadow: 0 16px 30px -10px rgba(0, 0, 0, 0.5);
		max-width: 220px;
	}

	.card-top {
		top: 8%;
		left: -10%;
	}

	.card-bottom {
		bottom: 8%;
		right: -8%;
	}

	.floating-icon {
		width: 34px;
		height: 34px;
		border-radius: 10px;
		background: var(--color-gold);
		color: var(--color-bg);
		display: grid;
		place-items: center;
		font-weight: 800;
		flex-shrink: 0;
	}

	.floating-icon.alt {
		background: var(--color-gold-dark);
	}

	.floating-card strong {
		display: block;
		font-size: 0.82rem;
		color: var(--color-ink);
	}

	.floating-card span {
		font-size: 0.74rem;
		color: rgba(244, 238, 224, 0.55);
	}

	.hero-marquee {
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
		background: var(--color-section);
		overflow: hidden;
		padding: 14px 0;
	}

	.marquee-track {
		display: flex;
		gap: 14px;
		white-space: nowrap;
		width: max-content;
		animation: scroll 26s linear infinite;
		color: rgba(244, 238, 224, 0.6);
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	@keyframes scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 900px) {
		.hero-inner {
			grid-template-columns: 1fr;
			padding-bottom: 40px;
		}
		.hero-visual {
			order: -1;
			max-width: 380px;
			margin: 0 auto;
		}
		.floating-card {
			display: none;
		}
	}
</style>
