---
import { getCalendlyUrl } from '../lib/calendly';

const calendlyUrl = getCalendlyUrl();

const stats = [
	{ value: '15+', label: 'Años de experiencia' },
	{ value: '600+', label: 'Casos resueltos' },
	{ value: '4.9/5', label: 'Calificación de clientes' },
	{ value: '24h', label: 'Tiempo de respuesta' },
]
---

<section class="hero" id="top">
	<div class="hero-media">
		<img
			src="https://cdn.pixabay.com/photo/2017/10/05/20/49/office-2820890_1280.jpg"
			alt="Abogado revisando documentos legales en su escritorio"
			loading="eager"
		/>
		<div class="hero-scrim"></div>
	</div>

	<div class="hero-content">
		<span class="eyebrow hero-fade" style="animation-delay: 0.05s">Abogados litigantes en Medellín</span>

		<h1 class="hero-fade" style="animation-delay: 0.18s">
			Defendemos tus derechos<br />
			con <em>estrategia</em> y experiencia
		</h1>

		<div class="hero-rule hero-fade" style="animation-delay: 0.3s"></div>

		<p class="hero-lead hero-fade" style="animation-delay: 0.38s">
			Asesoría legal integral en derecho civil, penal, laboral y comercial. Evaluamos tu
			caso sin costo y te damos una ruta clara de acción en menos de 24 horas.
		</p>

		<div class="hero-cta-row hero-fade" style="animation-delay: 0.5s">
			<button type="button" class="btn-primary" data-calendly-url={calendlyUrl}>
				Agenda tu consulta gratuita
			</button>
			<a href="https://wa.me/573004567890" target="_blank" rel="noopener" class="btn-ghost">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 6.32A8.9 8.9 0 0 0 12.05 4C7.4 4 3.62 7.78 3.62 12.42c0 1.5.4 2.96 1.13 4.24L3.5 20.5l3.94-1.23a8.87 8.87 0 0 0 4.6 1.26c4.65 0 8.43-3.78 8.43-8.43a8.83 8.83 0 0 0-2.87-6.28ZM12.05 19c-1.45 0-2.87-.39-4.1-1.13l-.29-.17-2.44.76.78-2.38-.19-.3a7.36 7.36 0 0 1-1.13-3.94c0-4.05 3.3-7.35 7.35-7.35 1.97 0 3.81.77 5.2 2.16a7.3 7.3 0 0 1 2.15 5.19c0 4.05-3.3 7.36-7.33 7.36Z"></path></svg>
				Escríbenos por WhatsApp
			</a>
		</div>
	</div>

	<div class="hero-stats hero-fade" style="animation-delay: 0.65s">
		{
			stats.map((s, i) => (
				<>
					<div class="stat">
						<strong>{s.value}</strong>
						<span>{s.label}</span>
					</div>
					{i < stats.length - 1 && <div class="stat-divider" aria-hidden="true" />}
				</>
			))
		}
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 92vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		padding: 140px 24px 0;
	}

	.hero-fade {
		opacity: 0;
		animation: heroFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	@keyframes heroFadeUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		filter: grayscale(0.35) brightness(0.55);
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(10, 9, 8, 0.55) 0%, rgba(10, 9, 8, 0.88) 62%, var(--color-bg) 100%),
			radial-gradient(ellipse at center 30%, transparent 0%, rgba(10, 9, 8, 0.4) 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 780px;
		margin: 0 auto;
		text-align: center;
		padding-bottom: 72px;
	}

	.eyebrow {
		display: inline-block;
		font-weight: 600;
		font-size: 0.76rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-gold-light);
		margin-bottom: 26px;
	}

	h1 {
		font-size: clamp(2.3rem, 5vw, 3.8rem);
		line-height: 1.14;
		color: var(--color-ink);
		font-weight: 500;
	}

	h1 em {
		font-style: italic;
		color: var(--color-gold-light);
	}

	.hero-rule {
		width: 64px;
		height: 1px;
		background: var(--color-gold);
		margin: 30px auto;
	}

	.hero-lead {
		font-size: 1.08rem;
		line-height: 1.7;
		color: rgba(244, 238, 224, 0.68);
		max-width: 52ch;
		margin: 0 auto;
	}

	.hero-cta-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		margin-top: 40px;
		flex-wrap: wrap;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: var(--color-gold);
		color: var(--color-bg);
		text-decoration: none;
		border: none;
		font-family: var(--font-body);
		font-size: 0.95rem;
		cursor: pointer;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: 17px 34px;
		border-radius: 2px;
		box-shadow: 0 10px 24px rgba(200, 162, 74, 0.22);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.btn-primary:hover {
		background: var(--color-gold-light);
		transform: translateY(-2px);
		box-shadow: 0 14px 30px rgba(200, 162, 74, 0.3);
	}

	.btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 17px 26px;
		color: var(--color-ink);
		border-bottom: 1px solid var(--color-line);
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.btn-ghost:hover {
		border-color: var(--color-gold);
		color: var(--color-gold-light);
	}

	.hero-stats {
		position: relative;
		z-index: 1;
		max-width: 1000px;
		margin: 0 auto;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		border-top: 1px solid var(--color-line);
		padding-top: 36px;
		padding-bottom: 48px;
	}

	.stat {
		flex: 1;
		text-align: center;
		padding: 0 16px;
	}

	.stat strong {
		display: block;
		font-family: var(--font-display);
		font-size: clamp(1.5rem, 2.6vw, 2.1rem);
		font-weight: 600;
		color: var(--color-gold-light);
		margin-bottom: 6px;
	}

	.stat span {
		display: block;
		font-size: 0.76rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(244, 238, 224, 0.55);
	}

	.stat-divider {
		width: 1px;
		height: 40px;
		background: var(--color-line);
		flex-shrink: 0;
	}

	@media (max-width: 720px) {
		.hero {
			min-height: auto;
			padding: 120px 20px 0;
		}

		.hero-stats {
			flex-wrap: wrap;
			row-gap: 28px;
		}

		.stat {
			flex: 1 1 40%;
		}

		.stat-divider {
			display: none;
		}
	}
</style>
