---
---

<div class="calendly-modal" id="calendly-modal" hidden>
	<div class="calendly-modal-backdrop" data-calendly-close></div>
	<div class="calendly-modal-panel" role="dialog" aria-modal="true" aria-label="Agendar consulta">
		<button type="button" class="calendly-modal-close" data-calendly-close aria-label="Cerrar">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 6l12 12M18 6L6 18"></path></svg>
		</button>
		<iframe id="calendly-modal-iframe" title="Agendar consulta" loading="lazy"></iframe>
	</div>
</div>

<script>
	const modal = document.getElementById('calendly-modal') as HTMLDivElement | null;
	const iframe = document.getElementById('calendly-modal-iframe') as HTMLIFrameElement | null;
	if (!modal || !iframe) throw new Error('Calendly modal markup missing');

	function open(url: string) {
		if (!modal || !iframe) return;
		iframe.src = url;
		modal.hidden = false;
		document.body.style.overflow = 'hidden';
	}

	function close() {
		if (!modal || !iframe) return;
		modal.hidden = true;
		iframe.src = 'about:blank';
		document.body.style.overflow = '';
	}

	document.addEventListener('click', (event) => {
		const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-calendly-url]');
		if (trigger) {
			event.preventDefault();
			open(trigger.dataset.calendlyUrl!);
			return;
		}
		if ((event.target as HTMLElement).closest('[data-calendly-close]')) {
			close();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && modal && !modal.hidden) close();
	});
</script>

<style>
	.calendly-modal {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
	}

	.calendly-modal[hidden] {
		display: none;
	}

	.calendly-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(3px);
	}

	.calendly-modal-panel {
		position: relative;
		width: min(920px, 100%);
		height: min(760px, 100%);
		background: var(--color-surface);
		border: 1px solid var(--color-line);
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.8);
		animation: calendlyPop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	@keyframes calendlyPop {
		from {
			opacity: 0;
			transform: scale(0.96) translateY(12px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.calendly-modal-close {
		position: absolute;
		top: 12px;
		right: 12px;
		z-index: 1;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: none;
		background: var(--color-surface-2);
		color: var(--color-ink);
		display: grid;
		place-items: center;
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.calendly-modal-close:hover {
		background: var(--color-gold);
		color: var(--color-bg);
		transform: rotate(90deg);
	}

	#calendly-modal-iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	@media (max-width: 640px) {
		.calendly-modal {
			padding: 0;
		}
		.calendly-modal-panel {
			width: 100%;
			height: 100%;
			border-radius: 0;
		}
	}
</style>
